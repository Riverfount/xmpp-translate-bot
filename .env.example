# Copie para .env e preencha os valores. .env nunca é commitado (ver
# .gitignore) — é a única fonte de segredos pro compose.yaml.

# --- XMPP ---
XMPP_JID=tradutor@seu-servidor.example
XMPP_PASSWORD=troque-me
XMPP_SERVER=seu-servidor.example:5222
XMPP_ROOMS=sala@conference.seu-servidor.example
XMPP_NICKNAME=tradutor
XMPP_TLS=true

# --- LibreTranslate ---
LT_URL=http://seu-libretranslate.example:5000
LT_API_KEY=troque-me
LT_TIMEOUT_MS=5000
LT_MAX_RETRIES=2

# --- Tradução ---
DEFAULT_TARGET=pt
TRANSLATION_PAIRS=
DETECTOR=libretranslate
MAX_TEXT_LENGTH=5000

# --- Pipeline / observabilidade ---
WORKER_POOL_SIZE=10
QUEUE_SIZE=100
LOG_LEVEL=info
METRICS_ADDR=:9090

# --- InfluxDB2 (extensão pós-spec) ---
# Pra testar contra o serviço influxdb2 deste compose.yaml (não o isaCloud de
# produção), deixe INFLUX_URL apontando pro nome do serviço — a rede interna
# do compose resolve isso — e use os MESMOS valores de INFLUXDB_INIT_TOKEN
# abaixo em INFLUX_TOKEN.
INFLUX_ENABLED=false
INFLUX_URL=http://influxdb2:8086
INFLUX_ORG=isacloud
INFLUX_BUCKET=telegraf
INFLUX_TOKEN=troque-me-mesmo-valor-de-INFLUXDB_INIT_TOKEN
INFLUX_TIMEOUT_MS=5000
INFLUX_QUEUE_SIZE=100

# --- Serviço influxdb2 do compose.yaml (setup inicial do container) ---
INFLUXDB_INIT_PASSWORD=troque-me
INFLUXDB_INIT_TOKEN=troque-me-mesmo-valor-de-INFLUX_TOKEN
